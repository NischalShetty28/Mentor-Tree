// Prisma Schema for Mentor-Mentee Management System
// SQLite-compatible schema with full relational constraints

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  role           String   @default("MENTEE") // MENTEE, MENTOR, ADMIN, HOD
  isActive       Boolean  @default(true)
  approvalStatus String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?
  adminProfile  AdminProfile?

  sentNotifications     Notification[]          @relation("SentNotifications")
  receivedNotifications Notification[]          @relation("ReceivedNotifications")
  auditLogs             AuditLog[]
  comments              RecommendationComment[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentees MenteeProfile[]
  mentors MentorProfile[]
  admins  AdminProfile[]
}

model MenteeProfile {
  id                String     @id @default(uuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  usn               String     @unique
  collegeEmail      String     @unique
  phone             String?
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  semester          Int        @default(1)
  academicYear      String     @default("2025-2026")
  section           String?    @default("A")
  cgpa              Float?     @default(0.0)
  sgpa              Float?     @default(0.0)
  attendancePercent Float?     @default(100.0)
  isRiskFlagged     Boolean    @default(false)
  riskLevel         String     @default("NONE") // NONE, LOW, MEDIUM, HIGH, CRITICAL

  // Personal / Mentoring development details
  hobbies                  String?
  interests                String?
  strengths                String?
  areasForImprovement      String?
  skills                   String?
  certifications           String?
  achievements             String?
  extracurricular          String?
  projects                 String?
  careerGoals              String?
  specializationPreference String?
  personalDevGoals         String?
  mentoringPreferences     String?
  privateNotes             String? // Mentee-private details (not shared with faculty)
  shareWithMentor          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments        MentorMenteeAssignment[]
  academicRecords    AcademicRecord[]
  attendanceRecords  AttendanceRecord[]
  recommendations    Recommendation[]
  tasks              StudentTask[]
  meetingAttendees   MeetingAttendee[]
  riskAlerts         AcademicRiskAlert[]
  mentorPrivateNotes MentorPrivateNote[]

  @@index([usn])
  @@index([departmentId])
  @@index([semester])
  @@index([riskLevel])
}

model MentorProfile {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  facultyId      String     @unique
  collegeEmail   String     @unique
  phone          String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  designation    String     @default("Assistant Professor")
  officeLocation String?
  maxMentees     Int        @default(20)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignments     MentorMenteeAssignment[]
  privateNotes    MentorPrivateNote[]
  recommendations Recommendation[]
  tasks           StudentTask[]
  meetings        Meeting[]

  @@index([facultyId])
  @@index([departmentId])
}

model AdminProfile {
  id                        String      @id @default(uuid())
  userId                    String      @unique
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String
  employeeId                String      @unique
  officialEmail             String      @unique
  phone                     String?
  departmentId              String? // Null for institution-wide Admin, set for HOD
  department                Department? @relation(fields: [departmentId], references: [id])
  administrativeDesignation String      @default("Mentor Coordinator")
  isSuperAdmin              Boolean     @default(false)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@index([employeeId])
  @@index([departmentId])
}

model MentorMenteeAssignment {
  id           String        @id @default(uuid())
  mentorId     String
  mentor       MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId     String
  mentee       MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  academicYear String        @default("2025-2026")
  semester     Int           @default(1)
  status       String        @default("ACTIVE") // ACTIVE, INACTIVE, COMPLETED, TRANSFERRED
  assignedAt   DateTime      @default(now())
  assignedBy   String? // User ID of Admin who assigned
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

model MentorPrivateNote {
  id             String        @id @default(uuid())
  mentorId       String
  mentor         MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId       String
  mentee         MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  title          String
  content        String
  category       String        @default("General") // "Behavioral", "Academic", "Personal", "Career"
  isConfidential Boolean       @default(true) // Visible only to faculty
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([mentorId])
  @@index([menteeId])
}

model Recommendation {
  id                 String        @id @default(uuid())
  mentorId           String
  mentor             MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId           String
  mentee             MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  title              String
  description        String
  category           String        @default("Academic") // Academic, Career, Skill, Attendance
  isAcknowledged     Boolean       @default(false)
  acknowledgedAt     DateTime?
  acknowledgmentNote String?
  status             String        @default("OPEN") // OPEN, ACKNOWLEDGED, IN_PROGRESS, COMPLETED, ARCHIVED
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  comments RecommendationComment[]
  tasks    StudentTask[]

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

model RecommendationComment {
  id               String         @id @default(uuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content          String
  createdAt        DateTime       @default(now())

  @@index([recommendationId])
  @@index([authorId])
}

model StudentTask {
  id               String          @id @default(uuid())
  mentorId         String?
  mentor           MentorProfile?  @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  menteeId         String
  mentee           MenteeProfile   @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  priority         String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate          DateTime?
  status           String          @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE, CANCELLED
  progressPercent  Int             @default(0)
  evidenceUrl      String?
  evidenceNotes    String?
  completedAt      DateTime?
  verifiedByMentor Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([menteeId])
  @@index([mentorId])
  @@index([status])
}

model Meeting {
  id                String        @id @default(uuid())
  mentorId          String
  mentor            MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  title             String
  agenda            String?
  meetingType       String        @default("INDIVIDUAL") // INDIVIDUAL, GROUP
  mode              String        @default("IN_PERSON") // IN_PERSON, ONLINE
  locationOrLink    String?
  scheduledAt       DateTime
  durationMinutes   Int           @default(30)
  status            String        @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  rescheduledReason String?
  mentorSummary     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  attendees MeetingAttendee[]

  @@index([mentorId])
  @@index([scheduledAt])
  @@index([status])
}

model MeetingAttendee {
  id               String        @id @default(uuid())
  meetingId        String
  meeting          Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  menteeId         String
  mentee           MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  attendanceStatus String        @default("SCHEDULED") // SCHEDULED, PRESENT, ABSENT, EXCUSED, RESCHEDULED
  menteeFeedback   String?
  actionItems      String?
  recordedAt       DateTime?

  @@unique([meetingId, menteeId])
  @@index([meetingId])
  @@index([menteeId])
}

model AcademicRecord {
  id           String        @id @default(uuid())
  menteeId     String
  mentee       MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  semester     Int
  academicYear String
  courseCode   String
  courseName   String
  credits      Int           @default(3)
  iaMarks      Float? // Internal Assessment
  endSemMarks  Float? // Final Exam
  totalMarks   Float?
  grade        String? // "S", "A", "B", "C", "D", "E", "F"
  isPassed     Boolean       @default(true)
  sgpa         Float?
  createdAt    DateTime      @default(now())

  @@index([menteeId])
  @@index([semester])
}

model AttendanceRecord {
  id                String        @id @default(uuid())
  menteeId          String
  mentee            MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  semester          Int
  academicYear      String
  courseCode        String
  courseName        String
  classesHeld       Int           @default(40)
  classesAttended   Int           @default(35)
  attendancePercent Float         @default(87.5)
  isShortage        Boolean       @default(false)
  updatedAt         DateTime      @updatedAt

  @@index([menteeId])
  @@index([semester])
}

model AcademicRiskAlert {
  id              String        @id @default(uuid())
  menteeId        String
  mentee          MenteeProfile @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  severity        String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  triggerReason   String
  metricsSnapshot String? // JSON string of metrics
  status          String        @default("NEW") // NEW, UNDER_REVIEW, ACTION_PLANNED, RESOLVED
  reviewedBy      String?
  reviewNotes     String?
  actionPlan      String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([menteeId])
  @@index([status])
  @@index([severity])
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  title       String
  message     String
  type        String    @default("SYSTEM") // MEETING, RECOMMENDATION, TASK, RISK_ALERT, APPROVAL, ASSIGNMENT, SYSTEM
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
}

model RiskThresholdConfig {
  id                     String   @id @default(uuid())
  departmentId           String?  @unique
  minAttendancePercent   Float    @default(75.0)
  minCgpa                Float    @default(6.5)
  maxFailedSubjects      Int      @default(1)
  maxConsecutiveAbsences Int      @default(2)
  updatedBy              String?
  updatedAt              DateTime @updatedAt
}
