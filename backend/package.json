  "version": "1.0.0",
  "description": "Backend API for Mentor-Mentee Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
